# Android Studio / Gradle build output
.gradle/
build/
/captures/
*.iml
.idea/
.DS_Store

# Local SDK path (machine-specific)
/local.properties

# Release signing keys — NEVER commit these. Anyone holding the keystore can
# publish updates that Android accepts as genuine. Back them up outside the repo.
*.jks
*.keystore
keystore.properties

# TLS-intercepting-proxy workaround — machine-specific, do not commit
# (see docs/ANDROID.md §7)
/gradle/cacerts
/.certs/

# Bundled web build: generated by `vite build` and copied in — never committed.
# Everything under assets/ is generated except the README that documents how to
# regenerate it. See that README for the bundle step.
/app/src/main/assets/*
!/app/src/main/assets/README.md
