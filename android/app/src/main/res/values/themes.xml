<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 base. The UI itself is the WebView; this theme styles the
         window chrome, splash background and status bar to match the web app. -->
    <style name="Theme.WmcLab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_cyan</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/brand_surface</item>
        <item name="android:navigationBarColor">@color/brand_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/brand_surface</item>
    </style>

    <!-- Cold-start splash (AndroidX SplashScreen). Shows the brand icon on the
         brand colour until the WebView has loaded, then hands off to Theme.WmcLab
         — so there is no black flash on launch. -->
    <style name="Theme.WmcLab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_cyan</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WmcLab</item>
    </style>
</resources>
