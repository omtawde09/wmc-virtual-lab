# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- PyInstaller backend build artifacts ----
# The .exe is distributed via GitHub Releases, not committed.
backend/build/
backend/dist/
*.exe

# ---- Node / Vite ----
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ---- Release artifacts ----
# Binaries are attached to GitHub Releases, never committed to the repo.
*.apk
*.aab
release-v*/

# ---- Signing keys ----
# Anyone holding these can publish updates Android accepts as genuine.
# Keep backups outside the repository.
*.jks
*.keystore
keystore.properties

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
